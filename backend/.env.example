# Instagramsci backend — environment.
# Copy to .env. DO NOT `source` this file in a shell — the app reads it directly.
# Just start the app (python3 app.py or gunicorn) and it loads .env itself.

# Postgres connection. The URL form is recommended: it has no spaces, so nothing
# can split or mangle it.
DATABASE_URL=postgresql://instagramsci:CHANGE_ME@127.0.0.1:5432/instagramsci
#   Key/value form also works now that .env is read directly (keep the quotes):
#   DATABASE_URL="dbname=instagramsci user=instagramsci password=CHANGE_ME host=127.0.0.1"
#   If your password has special characters (@ : / etc.) in the URL form,
#   URL-encode them — e.g. @ becomes %40.

# Secret for signing auth tokens. Anyone who has it can log in as any user, so
# keep this file out of the web root. The API refuses to start with the
# placeholder below or with anything shorter than 32 characters. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING

# Where uploaded post images are written (nginx should serve this dir at /uploads/)
UPLOAD_DIR=/var/www/instagramsci/backend/uploads

# Local API port (nginx proxies /api/ to this)
PORT=8077
